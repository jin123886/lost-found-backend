.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: linear-gradient(135deg, #4A90D9, #357ABD);
}
.logo-area { text-align: center; margin-bottom: 120rpx; }
.logo { font-size: 120rpx; }
.title { font-size: 44rpx; color: #fff; font-weight: bold; margin-top: 20rpx; }
.subtitle { font-size: 28rpx; color: rgba(255,255,255,0.7); margin-top: 10rpx; }
.login-btn {
  width: 500rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #4A90D9;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
}
