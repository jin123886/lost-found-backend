.detail-swiper { width: 100%; height: 420rpx; margin-bottom: 20rpx; }
.detail-image { width: 100%; height: 420rpx; }
.title-row { display: flex; justify-content: space-between; align-items: center; }
.detail-title { font-size: 34rpx; font-weight: bold; flex: 1; }
.stats-row { display: flex; justify-content: space-between; margin-top: 20rpx; color: #999; font-size: 24rpx; }
.info-row { display: flex; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; font-size: 28rpx; }
.info-row:last-child { border-bottom: none; }
.label { width: 140rpx; color: #999; flex-shrink: 0; }
.desc-text { font-size: 28rpx; line-height: 1.6; margin-top: 12rpx; }
.action-row { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.btn-secondary { flex: 1; background: #fff; color: #4A90D9; border: 1rpx solid #4A90D9; border-radius: 12rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; }
.comment-input {
  background: #f5f5f5; border-radius: 12rpx;
  padding: 20rpx; height: 140rpx; font-size: 28rpx;
}
.comment-btn { margin-top: 20rpx; }
.comment-list { margin-top: 20rpx; }
.comment-item { padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.comment-item:last-child { border-bottom: none; }
.comment-header { display: flex; justify-content: space-between; align-items: center; }
.comment-user { display: flex; align-items: center; gap: 16rpx; }
.comment-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #f0f0f0; }
.comment-name { font-size: 26rpx; font-weight: bold; }
.comment-time { margin-top: 6rpx; font-size: 22rpx; color: #999; }
.comment-content { margin-top: 16rpx; font-size: 28rpx; line-height: 1.6; color: #333; }
.comment-delete { color: #E74C3C; font-size: 24rpx; }
.empty-comment { margin-top: 20rpx; text-align: center; color: #999; font-size: 26rpx; }
.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.claim-modal {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx; z-index: 101;
}
.modal-title { font-size: 32rpx; font-weight: bold; margin-bottom: 24rpx; }
.modal-textarea {
  background: #f5f5f5; border-radius: 12rpx;
  padding: 20rpx; height: 160rpx; font-size: 28rpx;
}
.modal-btns { display: flex; gap: 20rpx; margin-top: 30rpx; }
.btn-cancel { flex: 1; background: #f0f0f0; border-radius: 12rpx; }
.btn-submit { flex: 1; background: #4A90D9; color: #fff; border-radius: 12rpx; }
