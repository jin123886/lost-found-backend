page { background: #f5f5f5; font-size: 28rpx; color: #333; }
.container { padding: 20rpx; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.btn-primary {
  background: #4A90D9;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx;
  text-align: center;
}
.btn-primary[disabled] { background: #ccc; }
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}
.tag-blue { background: #E8F4FD; color: #4A90D9; }
.tag-green { background: #E8F8E8; color: #52C41A; }
.tag-gray { background: #F0F0F0; color: #999; }

/* ========== 轮播图 ========== */
.swiper-container { width: 100%; height: 280rpx; margin-bottom: 20rpx; }
.swiper-container swiper { width: 100%; height: 100%; border-radius: 16rpx; overflow: hidden; }
.swiper-container swiper-item image { width: 100%; height: 100%; }

/* ========== 分类入口 ========== */
.category-grid { display: flex; flex-wrap: wrap; background: #fff; border-radius: 16rpx; padding: 20rpx 0; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.category-item { width: 33.33%; display: flex; flex-direction: column; align-items: center; padding: 16rpx 0; }
.category-icon { width: 80rpx; height: 80rpx; margin-bottom: 8rpx; display: flex; align-items: center; justify-content: center; background: #f0f5ff; border-radius: 50%; font-size: 40rpx; }
.category-name { font-size: 24rpx; color: #666; }
.category-item.active .category-icon { background: #4A90D9; }
.category-item.active .category-name { color: #4A90D9; font-weight: bold; }

/* ========== 增强卡片（带图片） ========== */
.card-with-image { display: flex; background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.card-image { width: 180rpx; height: 180rpx; border-radius: 12rpx; margin-right: 20rpx; flex-shrink: 0; background: #f5f5f5; }
.card-content { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.card-content .item-title { font-size: 30rpx; font-weight: bold; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-content .item-desc { font-size: 24rpx; color: #999; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin: 8rpx 0; }

/* ========== 统计信息 ========== */
.stats-row { display: flex; align-items: center; gap: 20rpx; font-size: 22rpx; color: #bbb; }
.stats-row .stat-item { display: flex; align-items: center; gap: 4rpx; }

/* ========== 评论区 ========== */
.comment-section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.comment-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; color: #333; }
.comment-item { display: flex; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.comment-item:last-child { border-bottom: none; }
.comment-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; margin-right: 16rpx; flex-shrink: 0; background: #eee; }
.comment-body { flex: 1; min-width: 0; }
.comment-author { font-size: 24rpx; color: #666; margin-bottom: 4rpx; }
.comment-text { font-size: 28rpx; color: #333; line-height: 1.5; word-wrap: break-word; }
.comment-time { font-size: 22rpx; color: #bbb; margin-top: 4rpx; }

/* ========== 底部输入栏 ========== */
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; padding: 16rpx 24rpx; background: #fff; border-top: 1rpx solid #eee; box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05); z-index: 100; }
.bottom-bar input { flex: 1; height: 72rpx; background: #f5f5f5; border-radius: 36rpx; padding: 0 24rpx; font-size: 28rpx; }
.bottom-bar .send-btn { margin-left: 16rpx; background: #4A90D9; color: #fff; border-radius: 36rpx; padding: 0 32rpx; height: 72rpx; line-height: 72rpx; font-size: 28rpx; border: none; }

/* ========== 收藏按钮 ========== */
.collect-btn { display: flex; align-items: center; gap: 4rpx; padding: 8rpx 16rpx; border-radius: 8rpx; font-size: 24rpx; color: #999; background: #f5f5f5; }
.collect-btn.active { color: #ff6b6b; background: #fff0f0; }

/* ========== 用户统计卡片 ========== */
.user-stats { display: flex; justify-content: space-around; background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.stat-block { display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 36rpx; font-weight: bold; color: #4A90D9; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 4rpx; }
